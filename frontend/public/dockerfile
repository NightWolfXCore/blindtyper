FROM php:8.2-fpm-alpine

# Устанавливаем зависимости для PHP и расширения
RUN apk add --no-cache \
    $PHPIZE_DEPS \
    libzip-dev \
    icu-dev \
    oniguruma-dev \
    && docker-php-ext-install pdo_mysql mbstring intl zip

# Устанавливаем Composer
COPY --from=composer:latest /usr/bin/composer /usr/bin/composer

# Устанавливаем рабочую директорию
WORKDIR /var/www/html

# Копируем проект (в dev-режиме мы будем использовать volumes, но для кэша слоев)
COPY . .

# Даем права на папку storage (если она нужна для сессий/кэша)
RUN mkdir -p storage && chmod -R 777 storage || true

USER www-data